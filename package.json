{
  "name": "hyposea-agent",
  "version": "1.0.0",
  "description": "Discord bot that bridges #mainframe-channel to the AGY (Antigravity) CLI agent",
  "main": "dist/index.js",
  "bin": {
    "hyposea": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx src/cli/index.ts doctor",
    "setup": "tsx src/cli/index.ts setup"
  },
  "keywords": [
    "discord",
    "bot",
    "antigravity",
    "agy",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
