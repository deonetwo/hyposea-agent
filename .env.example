# Discord bot token for the AGY Mainframe Bridge agent
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Enable/disable the interactive AGY Mainframe bridge
MAINFRAME_ENABLED=true

# Channel name where the bot listens for mainframe prompts
MAINFRAME_CHANNEL=mainframe-channel

# Comma-separated list of authorized Discord User IDs who can issue commands
MAINFRAME_AUTHORIZED_USERS=

# Prefix required to trigger AGY (mentions @bot and threads also work)
MAINFRAME_PREFIX=!agy

# Absolute path to the AGY CLI executable
AGY_BIN_PATH=/home/ubuntu/.local/bin/agy

# [OPTIONAL] Working directory for AGY execution (defaults to project root)
HYPOSEA_WORKDIR=

# [OPTIONAL] SQLite database path (defaults to ./data/hyposea.db)
HYPOSEA_DB_PATH=

# [OPTIONAL] Skip permission confirmation in AGY (default: false, conservative)
AGY_SKIP_PERMISSIONS=false

# [OPTIONAL] Whitelist of allowed Guild IDs (comma-separated). Leave empty to allow any guild.
ALLOWED_GUILD_IDS=
